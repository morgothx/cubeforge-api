# Copy to .env for local development. Never put real AWS credentials here.

# --- AWS / Floci (local emulator only) ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Where the analytical export writes. One bucket for the whole platform; a
# tenant's objects are separated by prefix, not by bucket. The endpoint above
# must be the emulator — the export refuses to start against a real account,
# because writing a tenant's history somewhere it cannot be taken back from is
# not a mistake worth allowing.
EXPORT_BUCKET=cubeforge-exports

# --- PostgreSQL (OLTP) ---
# Three separate identities, on purpose. A table owner bypasses row-level
# security, so the identities that serve requests must never own the schema.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cubeforge

# Owns the schema, applies migrations, never serves a request.
POSTGRES_MIGRATOR_USER=cubeforge_migrator
POSTGRES_MIGRATOR_PASSWORD=migrator-dev-only

# Tenant-scoped runtime identity. Every row it sees is filtered by policy.
POSTGRES_APP_USER=cubeforge_app
POSTGRES_APP_PASSWORD=app-dev-only

# Platform-operator identity. Manages tenants, holds no grant on memberships.
POSTGRES_OPERATOR_USER=cubeforge_operator
POSTGRES_OPERATOR_PASSWORD=operator-dev-only

# Bootstrap superuser for the local container only (see docker-compose.yml).
POSTGRES_USER=cubeforge
POSTGRES_PASSWORD=cubeforge

# Reads credentials, with no tenant context. Resolving an API key must discover
# which tenant it belongs to, so it cannot run under a tenant-keyed policy.
POSTGRES_AUTHENTICATOR_USER=cubeforge_authenticator
POSTGRES_AUTHENTICATOR_PASSWORD=authenticator-dev-only

# --- Authentication ---
# Signs access tokens. At least 32 characters; generate a fresh one per
# environment and never reuse this placeholder outside local development.
AUTH_TOKEN_SECRET=local-development-only-signing-secret-change-me
# Access token lifetime in seconds. Short on purpose: ending a session cannot
# revoke a token already issued, so the window is bounded instead.
AUTH_ACCESS_TOKEN_SECONDS=900

# --- Guessing resistance ---
# All optional: the defaults below are what the application uses when they are
# unset. Attempts are counted over the window; exceeding a count costs the
# caller the cooling period. Signing in is counted per address *and* per origin,
# because either count alone is avoidable. No count ever disables an account.
AUTH_THROTTLE_WINDOW_SECONDS=300
AUTH_THROTTLE_COOLDOWN_SECONDS=900
AUTH_SIGN_IN_ATTEMPTS_PER_ADDRESS=10
AUTH_SIGN_IN_ATTEMPTS_PER_ORIGIN=60
AUTH_REDEMPTIONS_PER_ORIGIN=20

# --- Cube.dev ---
CUBEJS_API_SECRET=dev-only-not-a-real-secret

# --- API ---
PORT=3000
