# Copy to .env for local development. Never put real AWS credentials here.

# --- AWS / Floci (local emulator only) ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- PostgreSQL (OLTP) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cubeforge
POSTGRES_PASSWORD=cubeforge
POSTGRES_DB=cubeforge

# --- Cube.dev ---
CUBEJS_API_SECRET=dev-only-not-a-real-secret

# --- API ---
PORT=3000
